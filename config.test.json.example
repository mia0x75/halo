{
  "log": {
    "level": "info"
  },
  "cert": "certs/cert.pem",
  "key": "certs/key.pem",
  "listen": ":8443",
  "database": {
    "driver": "mysql",
    "addr": "root:test@tcp(127.0.0.1:3307)/halo_test?charset=utf8mb4&parseTime=true&loc=UTC&time_zone=%27%2B00%3A00%27",
    "max_idle": 10,
    "max_connections": 100,
    "wait_timeout": 300
  },
  "secret": {
    "jwt": {
      "token_name": "Authentication",
      "issuer": "halo",
      "secret_key": "test-only-32-hex-chars-0000000000"
    },
    "crypto": "test-only-aes-key"
  }
}
